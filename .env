# App Configuration
PORT=3000

# Database Configuration (ชี้ไปยัง Container 'db' ใน Docker Network)
DB_HOST=db
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=event_qr_db
DB_PORT=3306

# Mailer SMTP Configuration (ตัวอย่าง Gmail หรือ SMTP Server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SENDER_NAME=Event Security System
